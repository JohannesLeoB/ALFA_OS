#!/bin/sh
# Check every pushed ref (R1 to R7), then run the full check (R8).
ROOT=$(git rev-parse --show-toplevel) || exit 1
seen=0
while read -r local_ref local_sha remote_ref remote_sha; do
  seen=1
  python3 "$ROOT/scripts/waechter.py" push "$remote_sha" "$local_sha" "$remote_ref" || exit 1
done
[ "$seen" = 1 ] || exit 0
cd "$ROOT" || exit 1
exec bash scripts/pruefen.sh
