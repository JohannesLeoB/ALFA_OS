#!/bin/sh
ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1
app=0
while read -r local_ref local_sha remote_ref remote_sha; do
  changed=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null) || changed="alfaos/"
  printf '%s\n' "$changed" | grep -q '^alfaos/' && app=1
done
[ "$app" = 1 ] || exit 0
swift test --package-path alfaos/Kit >/tmp/alfa-prepush.log 2>&1 || { tail -n 40 /tmp/alfa-prepush.log; exit 1; }
echo "alfaos/Kit: swift test ok"
