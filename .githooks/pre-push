#!/bin/sh
ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1
seen=0
kit=0
while read -r local_ref local_sha remote_ref remote_sha; do
  seen=1
  python3 scripts/waechter.py push "$remote_sha" "$local_sha" "$remote_ref" || exit 1
  changed=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null) || changed="alfaos/"
  if printf '%s\n' "$changed" | grep -q '^alfaos/'; then
    kit=1
  fi
done
[ "$seen" = 1 ] || exit 0
python3 scripts/waechter_test.py || exit 1
python3 scripts/waechter_signals_test.py || exit 1
if [ "$kit" = 1 ]; then
  log=$(swift test --package-path alfaos/Kit 2>&1) || { printf '%s\n' "$log" | tail -n 40; exit 1; }
  printf '%s\n' "$log" | grep -E 'Executed [0-9]+ tests' | tail -n 1
fi
exit 0
