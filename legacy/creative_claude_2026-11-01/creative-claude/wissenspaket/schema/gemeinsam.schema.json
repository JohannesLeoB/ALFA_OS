{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.kueche.local/v0/gemeinsam.schema.json",
  "title": "Gemeinsame Typen",
  "description": "Bausteine fuer alle Schemata (v0.2). Laengen in mm, Winkel in Grad. Koordinaten rechtshaendig (x kreuz y = z), z nach oben, z = 0 auf OKFF. Raumsystem: Wand A = planungsbogen.raum.waende[0]; sie liegt auf der x-Achse von grundriss[von] = [0,0] nach grundriss[nach] = [L,0], der Raum bei y > 0. Vom Raum aus auf Wand A geblickt laeuft x nach links. Teilsystem: siehe teil.schema.json.",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"},
    "herkunft": {
      "type": "string",
      "enum": ["kern", "setup", "projekt", "gemessen", "annahme"],
      "description": "kern, setup, projekt, gemessen = bestaetigte Werte (Vorrang projekt > setup > kern; gemessen kommt aus Aufmass oder Modell). annahme = unbestaetigt: Fallback, gelernter Kandidat, unbestaetigte Setup-Regel. Nur annahme erscheint in annahmen[]."
    },
    "beleg": {
      "type": "object",
      "properties": {
        "quelle": {"type": "string", "description": "Datei-, Bibliotheks-, Regel- oder Messungs-ID"},
        "ref": {"type": "string", "description": "Seite, Layer, Feld, Zeile"},
        "ableitung": {"type": "string", "description": "Formel; Pflicht, wenn der Wert abgeleitet ist"}
      },
      "required": ["quelle"],
      "additionalProperties": false
    },
    "einheit": {"type": "string", "enum": ["mm", "m", "m2", "grad", "stk", "kg", "l", "w", "v", "a", "eur", "mm/min", "m/min", "u/min", "s", "%", "-"]},
    "wert": {
      "description": "Ein Wert mit Herkunft. Jede planungsrelevante Zahl wird so gefuehrt.",
      "type": "object",
      "properties": {
        "wert": {"type": ["number", "string", "boolean"]},
        "einheit": {"$ref": "#/$defs/einheit"},
        "herkunft": {"$ref": "#/$defs/herkunft"},
        "beleg": {"$ref": "#/$defs/beleg"},
        "toleranz": {"type": "number", "minimum": 0}
      },
      "required": ["wert", "herkunft"],
      "additionalProperties": false
    },
    "punkt2": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "punkt3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "masse3": {
      "type": "object",
      "properties": {"b": {"type": "number", "minimum": 0}, "t": {"type": "number", "minimum": 0}, "h": {"type": "number", "minimum": 0}},
      "required": ["b", "t", "h"],
      "additionalProperties": false
    },
    "lage": {
      "description": "pos = lokaler Ursprung des Elements im System des Elternelements (Wurzel: Raumsystem); rot_z dreht das Element um pos gegen den Uhrzeigersinn (Blick von oben). Lokal: x entlang der Front, y von der Wand in den Raum, z nach oben; der Korpus belegt 0..b, 0..t, 0..h, die Front liegt bei y = t. Bei rot_z = 0 ist pos die Ecke mit kleinstem x, y, z.",
      "type": "object",
      "properties": {"pos": {"$ref": "#/$defs/punkt3"}, "rot_z": {"type": "number", "default": 0}},
      "required": ["pos"],
      "additionalProperties": false
    },
    "bibref": {
      "description": "Verweis auf einen Bibliothekseintrag. stand friert den Katalogstand ein.",
      "type": "object",
      "properties": {
        "bibliothek": {"type": "string", "enum": ["material", "kante", "beschlag", "geraet", "zukauf", "asset", "vorlage", "stil"]},
        "id": {"$ref": "#/$defs/id"},
        "stand": {"type": "string", "format": "date"}
      },
      "required": ["bibliothek", "id"],
      "additionalProperties": false
    },
    "bibref_fest": {
      "description": "bibref mit Pflicht-Stand; im Kuechenmodell und in Teilen zu verwenden.",
      "$ref": "#/$defs/bibref",
      "required": ["stand"]
    },
    "anschluss": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "art": {"type": "string", "enum": ["wasser_kalt", "wasser_warm", "abwasser", "strom_230", "strom_400", "strom_kleinspannung", "gas", "abluft", "zuluft", "netzwerk", "potentialausgleich"]},
        "status": {"type": "string", "enum": ["bestand", "geplant"]},
        "pos": {"$ref": "#/$defs/punkt3"},
        "wand": {"$ref": "#/$defs/id"},
        "toleranz": {"type": "number", "minimum": 0},
        "dimension": {"type": "string", "description": "z. B. DN50, 3x2,5 mm2, 1/2 Zoll"},
        "absicherung_a": {"type": "number"},
        "element": {"$ref": "#/$defs/id", "description": "versorgtes Element oder Geraet"},
        "herkunft": {"$ref": "#/$defs/herkunft"}
      },
      "required": ["id", "art", "status", "pos", "herkunft"],
      "additionalProperties": false
    },
    "ausgabe": {
      "description": "Ein Vokabular fuer Ausgaben: Planungsbogen.ausgaben, Setup.ausgaben, Werkzeug ausgeben.ziel.",
      "type": "string",
      "enum": ["zuschnittliste", "zuschnittplan", "etiketten", "werkplan", "bestellliste", "anschlussplan", "praesentation", "montage", "dxf", "step", "vorschau_3d", "kantenliste", "cnc", "ifc", "fusion", "rendering"]
    },
    "ausgabe_fertigung": {
      "description": "Ausgaben, die an die Werkstatt gehen und eine freigegebene Revision verlangen.",
      "type": "string",
      "enum": ["zuschnittliste", "zuschnittplan", "etiketten", "werkplan", "bestellliste", "montage", "dxf", "step", "kantenliste", "cnc"]
    },
    "messquelle": {"type": "string", "enum": ["laser", "scan", "roomplan", "manuell", "plan_bestand"]},
    "griff": {"type": "string", "enum": ["grifflos_pto", "griffmulde_gefraest", "griffleiste", "griff", "knopf", "gemischt"]},
    "schwere": {"type": "string", "enum": ["fehler", "warnung", "hinweis"]},
    "regel_id": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$"}
  }
}
