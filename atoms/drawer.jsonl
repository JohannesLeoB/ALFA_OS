{"id": "ATM-DRW-0001", "kind": "rule", "domain": "drawer", "statement": "For a wooden drawer on a TANDEM runner for 11 to 16 mm sides, the drawer inside width is the inside width of the carcass minus 42 mm.", "formula": "drawer_inside_width = inside_width - 42 (+0 / -1.5)", "applies_to": ["blum_tandem_560h", "blum_tandem_550h", "blum_tandem_561h"], "rule": "rules/drawer.py:wooden_drawer", "stage": "production", "status": "proposed", "evidence": "verified", "sources": [{"id": "SRC-BLUM-005", "locator": "TD-127/3, installation dimensions"}, {"id": "SRC-BLUM-009", "locator": "pages 447, 449, 457"}], "added": "2026-11-01"}
{"id": "ATM-DRW-0002", "kind": "rule", "domain": "drawer", "statement": "For a wooden drawer on a TANDEM runner for 17 to 19 mm sides, the drawer inside width is the inside width of the carcass minus 49 mm.", "formula": "drawer_inside_width = inside_width - 49 (+0 / -1.5)", "applies_to": ["blum_tandem_560f"], "rule": "rules/drawer.py:wooden_drawer", "stage": "production", "status": "proposed", "evidence": "verified", "sources": [{"id": "SRC-BLUM-006", "locator": "TD-131/3, installation dimensions"}], "added": "2026-11-01"}
{"id": "ATM-DRW-0003", "kind": "rule", "domain": "drawer", "statement": "For a wooden drawer on a MOVENTO runner, the drawer inside width is the inside width of the carcass minus 42 mm.", "formula": "drawer_inside_width = inside_width - 42 (+0 / -1.5)", "applies_to": ["blum_movento_760h", "blum_movento_766h"], "rule": "rules/drawer.py:wooden_drawer", "stage": "production", "status": "proposed", "evidence": "verified", "sources": [{"id": "SRC-BLUM-010", "locator": "installation formulas"}, {"id": "SRC-BLUM-011", "locator": "page 421"}], "added": "2026-11-01"}
{"id": "ATM-DRW-0004", "kind": "rule", "domain": "drawer", "statement": "For a wooden drawer on a TANDEM or MOVENTO runner, the drawer length is the nominal length minus 10 mm.", "formula": "drawer_length = nominal_length - 10", "applies_to": ["blum_tandem_560h", "blum_tandem_550h", "blum_tandem_561h", "blum_tandem_560f", "blum_movento_760h", "blum_movento_766h"], "rule": "rules/drawer.py:wooden_drawer", "stage": "production", "status": "proposed", "evidence": "verified", "sources": [{"id": "SRC-BLUM-005", "locator": "TD-127/3"}, {"id": "SRC-BLUM-006", "locator": "TD-131/3"}, {"id": "SRC-BLUM-011", "locator": "page 421"}], "added": "2026-11-01"}
{"id": "ATM-DRW-0005", "kind": "rule", "domain": "drawer", "statement": "The inside depth of the carcass must be at least the nominal length of the runner plus 3 mm.", "formula": "inside_depth >= nominal_length + 3", "applies_to": ["blum_tandem_560h", "blum_tandem_560f", "blum_movento_760h", "blum_movento_766h", "blum_legrabox"], "rule": "rules/drawer.py:depth_requirement", "stage": "production", "status": "proposed", "evidence": "verified", "sources": [{"id": "SRC-BLUM-003", "locator": "page 196"}, {"id": "SRC-BLUM-005", "locator": "TD-127/3"}, {"id": "SRC-BLUM-010", "locator": "space requirement"}], "added": "2026-11-01"}
{"id": "ATM-DRW-0006", "kind": "rule", "domain": "drawer", "statement": "Add 12 mm to the depth requirement of a MOVENTO runner when the drawer has side stabilisation.", "formula": "depth_requirement += 12", "applies_to": ["blum_movento_760h", "blum_movento_766h"], "rule": "rules/drawer.py:depth_requirement", "stage": "production", "status": "proposed", "evidence": "verified", "sources": [{"id": "SRC-BLUM-010", "locator": "space requirement extras"}, {"id": "SRC-BLUM-011", "locator": "page 421"}], "added": "2026-11-01"}
{"id": "ATM-DRW-0007", "kind": "rule", "domain": "drawer", "statement": "For an inner drawer on a TANDEM or MOVENTO runner, the depth requirement is the nominal length plus the front thickness plus 3 mm with soft close or plus 7 mm with push to open.", "formula": "depth_requirement = nominal_length + front_thickness + (3 | 7)", "applies_to": ["blum_tandem_560h", "blum_movento_760h", "blum_movento_766h"], "rule": "rules/drawer.py:depth_requirement", "stage": "production", "status": "proposed", "evidence": "verified", "sources": [{"id": "SRC-BLUM-005", "locator": "TD-127/3"}, {"id": "SRC-BLUM-010", "locator": "space requirement"}], "added": "2026-11-01"}
{"id": "ATM-DRW-0008", "kind": "rule", "domain": "drawer", "statement": "Use the largest nominal length whose depth requirement fits in the inside depth of the carcass.", "formula": "nominal_length = max(n for n in lengths if depth_requirement(n) <= inside_depth)", "rule": "rules/drawer.py:select_nominal_length", "stage": "production", "status": "proposed", "evidence": "interpretation", "sources": [{"id": "SRC-REPORT-001", "locator": "section 3, selection rule"}], "added": "2026-11-01", "note": "Blum gives no selection rule. This rule is a conclusion from ATM-DRW-0005."}
{"id": "ATM-DRW-0009", "kind": "rule", "domain": "drawer", "statement": "For a LEGRABOX drawer with a wooden back and a 16 mm chipboard bottom, the bottom width is the inside width of the carcass minus 35 mm and the back width is the inside width minus 38 mm.", "formula": "bottom_width = inside_width - 35; back_width = inside_width - 38", "applies_to": ["blum_legrabox"], "rule": "rules/drawer.py:legrabox_parts", "stage": "production", "status": "proposed", "evidence": "derived", "sources": [{"id": "SRC-BLUM-004", "locator": "page 203, cutting for 16 mm chipboard"}, {"id": "SRC-BLUM-003", "locator": "pages 196 to 213"}], "added": "2026-11-01", "note": "German catalogue extracts swap the two labels. Check on the original drawing before production."}
{"id": "ATM-DRW-0010", "kind": "rule", "domain": "drawer", "statement": "For a LEGRABOX drawer, the bottom length is the nominal length minus 10 mm with a wooden back or minus 21 mm with a steel back.", "formula": "bottom_length = nominal_length - 10 (wood) | - 21 (steel)", "applies_to": ["blum_legrabox"], "rule": "rules/drawer.py:legrabox_parts", "stage": "production", "status": "proposed", "evidence": "derived", "sources": [{"id": "SRC-BLUM-004", "locator": "page 203"}, {"id": "SRC-BLUM-002", "locator": "page 4"}], "added": "2026-11-01"}
{"id": "ATM-DRW-0011", "kind": "fact", "domain": "drawer", "statement": "With TIP-ON BLUMOTION the front gap is 2.5 mm on all sides of the front.", "value": {"start": 2.5, "unit": "mm"}, "applies_to": ["blum_legrabox", "blum_movento_760h", "blum_movento_766h"], "stage": "production", "status": "proposed", "evidence": "verified", "sources": [{"id": "SRC-BLUM-013", "locator": "TIP-ON BLUMOTION processing and assembly, front gap"}], "added": "2026-11-01"}
{"id": "ATM-DRW-0012", "kind": "pattern", "domain": "drawer", "statement": "The old studio sample kitchens use drawer parts of 512 mm and 500 mm and a back panel of 562 mm. These values do not agree with the Blum rules for an inside width of 562 mm.", "stage": "production", "status": "open", "evidence": "interpretation", "sources": [{"id": "SRC-REPORT-001", "locator": "section 1.3"}], "added": "2026-11-01", "note": "Correct the sample part lists after Johannes confirms the studio values."}
