{
  "title": "setup",
  "type": "object",
  "required": ["id", "level", "status", "values"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^SET-[A-Z0-9-]+$"},
    "level": {"enum": ["default", "workshop", "project"]},
    "status": {"enum": ["decided", "proposed", "open"]},
    "values": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["value", "status", "evidence"],
        "additionalProperties": false,
        "properties": {
          "value": {},
          "status": {"enum": ["decided", "proposed", "open"]},
          "evidence": {"enum": ["verified", "extracted", "derived", "uncertain", "master_data", "owner", "interpretation"]},
          "atom": {"type": "string", "pattern": "^ATM-[A-Z]{3}-[0-9]{4}$"},
          "note": {"type": "string"}
        }
      }
    },
    "note": {"type": "string"}
  }
}
