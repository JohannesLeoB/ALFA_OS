{
  "title": "library entry",
  "type": "object",
  "required": ["id", "library", "maker", "series", "name", "attributes", "status", "sharing", "sources", "added"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^LIB-(HW|MAT|EDG|APL)-[A-Z0-9-]+$"},
    "library": {"enum": ["hardware", "material", "edge", "appliance"]},
    "maker": {"type": "string"},
    "series": {"type": "string"},
    "name": {"type": "string"},
    "attributes": {"type": "object"},
    "rule": {"type": "string", "pattern": "^rules/[a-z_]+\\.py:[a-z_]+$"},
    "status": {"enum": ["unchecked", "checked"]},
    "sharing": {"enum": ["setup_only", "open"]},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "locator"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^SRC-[A-Z0-9]+-[0-9]{3}$"},
          "locator": {"type": "string"}
        }
      }
    },
    "added": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "checked": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "note": {"type": "string"}
  }
}
