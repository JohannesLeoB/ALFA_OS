{
  "title": "atom",
  "type": "object",
  "required": ["id", "kind", "domain", "statement", "stage", "status", "evidence", "sources", "added"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^ATM-[A-Z]{3}-[0-9]{4}$"},
    "kind": {"enum": ["rule", "dimension", "pattern", "style", "fact"]},
    "domain": {"enum": ["carcass", "drawer", "front", "board", "edge", "hardware", "appliance", "layout", "drawing"]},
    "statement": {"type": "string"},
    "condition": {"type": "string"},
    "formula": {"type": "string"},
    "value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {"type": "number"},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "unit": {"enum": ["mm", "kg", "deg", "count", "ratio"]}
      }
    },
    "applies_to": {"type": "array", "items": {"type": "string"}},
    "rule": {"type": "string", "pattern": "^rules/[a-z_]+\\.py:[a-z_]+$"},
    "stage": {"enum": ["design", "production"]},
    "status": {"enum": ["decided", "proposed", "open"]},
    "evidence": {"enum": ["verified", "derived", "uncertain", "master_data", "interpretation"]},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "locator"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^SRC-[A-Z0-9]+-[0-9]{3}$"},
          "locator": {"type": "string"}
        }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hits": {"type": "integer", "minimum": 0},
        "misses": {"type": "integer", "minimum": 0},
        "untestable": {"type": "integer", "minimum": 0}
      }
    },
    "added": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "checked": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "note": {"type": "string"}
  }
}
