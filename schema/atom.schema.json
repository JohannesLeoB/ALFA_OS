{
  "title": "atom",
  "type": "object",
  "required": ["id", "kind", "domain", "concepts", "statement_en", "statement_de", "stage", "status", "evidence", "sources", "proposed_by", "added"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^ATM-[A-Z]{3}-[0-9]{4}$"},
    "kind": {"enum": ["rule", "dimension", "pattern", "style", "fact", "problem", "solution", "trick"]},
    "domain": {"enum": ["carcass", "drawer", "front", "board", "edge", "hardware", "appliance", "layout", "drawing"]},
    "concepts": {"type": "array", "items": {"type": "string", "pattern": "^CON-[A-Z0-9-]+$"}},
    "statement_en": {"type": "string"},
    "statement_de": {"type": "string"},
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rel", "to"],
        "additionalProperties": false,
        "properties": {
          "rel": {"enum": ["same_rule_as", "variant_of", "extends", "follows_from", "conflicts_with", "supersedes", "exception_to", "related", "solves", "alternative_to", "combines_with", "contrasts_with", "inspired_by"]},
          "to": {"type": "string", "pattern": "^(ATM|CON|LIB|MED)-[A-Z0-9-]+$"}
        }
      }
    },
    "proposed_by": {"type": "string"},
    "decided_by": {"type": "string"},
    "condition": {"type": "string"},
    "formula": {"type": "string"},
    "value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {"type": "number"},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "unit": {"enum": ["mm", "kg", "deg", "count", "ratio"]}
      }
    },
    "applies_to": {"type": "array", "items": {"type": "string"}},
    "rule": {"type": "string", "pattern": "^rules/[a-z_]+\\.py:[a-z_]+$"},
    "stage": {"enum": ["design", "production"]},
    "status": {"enum": ["decided", "proposed", "open"]},
    "evidence": {"enum": ["verified", "extracted", "derived", "uncertain", "master_data", "owner", "interpretation"]},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "locator"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^SRC-[A-Z0-9]+-[0-9]{3}$"},
          "locator": {"type": "string"}
        }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hits": {"type": "integer", "minimum": 0},
        "misses": {"type": "integer", "minimum": 0},
        "untestable": {"type": "integer", "minimum": 0}
      }
    },
    "added": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "checked": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "note": {"type": "string"}
  }
}
