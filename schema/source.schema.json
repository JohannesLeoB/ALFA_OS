{
  "title": "source",
  "type": "object",
  "required": ["id", "kind", "publisher", "title", "edition", "location", "trust", "added"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^SRC-[A-Z0-9]+-[0-9]{3}$"},
    "kind": {"enum": ["maker_document", "maker_web_page", "maker_catalogue", "norm", "dealer_document", "studio_master_data", "studio_drawing", "research_report", "book"]},
    "publisher": {"type": "string"},
    "title": {"type": "string"},
    "edition": {"type": "string"},
    "location": {"type": "string"},
    "trust": {"enum": ["original", "third_party", "studio"]},
    "added": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "note": {"type": "string"}
  }
}
