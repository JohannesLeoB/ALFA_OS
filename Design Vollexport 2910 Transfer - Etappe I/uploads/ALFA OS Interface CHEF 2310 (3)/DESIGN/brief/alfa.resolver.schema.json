{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alfa.resolver.schema.json",
  "title": "ALFA resolver (DTCG Resolver Module 2025.10, ALFA profile)",
  "description": "alfa.resolver.json. One set 'base', one modifier 'theme' with contexts light and dark (later: lightGray). resolutionOrder: base, then theme.",
  "type": "object",
  "required": [
    "version",
    "sets",
    "modifiers",
    "resolutionOrder"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "description": {
      "type": "string"
    },
    "sets": {
      "type": "object",
      "required": [
        "base"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/set"
      }
    },
    "modifiers": {
      "type": "object",
      "required": [
        "theme"
      ],
      "properties": {
        "theme": {
          "allOf": [
            {
              "$ref": "#/$defs/modifier"
            },
            {
              "properties": {
                "contexts": {
                  "required": [
                    "light",
                    "dark"
                  ]
                },
                "default": {
                  "const": "light"
                }
              },
              "required": [
                "default"
              ]
            }
          ]
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/modifier"
      }
    },
    "resolutionOrder": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "$extensions": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "object",
      "required": [
        "$ref"
      ],
      "properties": {
        "$ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "set": {
      "type": "object",
      "required": [
        "sources"
      ],
      "properties": {
        "sources": {
          "$ref": "#/$defs/sources"
        },
        "description": {
          "type": "string"
        },
        "$extensions": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "modifier": {
      "type": "object",
      "required": [
        "contexts"
      ],
      "properties": {
        "contexts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/sources"
          }
        },
        "default": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "$extensions": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
