{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "views.schema.json",
  "title": "ALFA views (one entry per view area)",
  "description": "views.json. Each view area places components and elements in the three lanes of the shell and lists its actions. Actions without a drawn element are build needs.",
  "type": "object",
  "required": [
    "version",
    "views"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/view"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "kebab": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "camel": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "elementId": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-z0-9]*(-[a-z0-9]+)*)+$"
    },
    "textKey": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)+$"
    },
    "where": {
      "type": "string",
      "pattern": "^[^:]+\\.(dc\\.html|js|css):\\d+$"
    },
    "lane": {
      "type": "object",
      "required": [
        "header",
        "content"
      ],
      "properties": {
        "header": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/elementId"
          }
        },
        "content": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/kebab"
          }
        },
        "footer": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/elementId"
          }
        },
        "locked": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": [
        "id",
        "element",
        "result"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/camel"
        },
        "element": {
          "$ref": "#/$defs/elementId"
        },
        "result": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "confirm": {
          "enum": [
            "none",
            "hold",
            "undo"
          ]
        },
        "feedbackKey": {
          "$ref": "#/$defs/textKey"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "required": [
        "area",
        "file",
        "lanes",
        "actions",
        "states",
        "textKeys"
      ],
      "properties": {
        "area": {
          "enum": [
            "shell",
            "mail",
            "settings",
            "projects",
            "today",
            "catalogs",
            "cart"
          ]
        },
        "file": {
          "type": "string",
          "pattern": "\\.dc\\.html$"
        },
        "lanes": {
          "type": "object",
          "required": [
            "leading",
            "center",
            "trailing"
          ],
          "properties": {
            "leading": {
              "$ref": "#/$defs/lane"
            },
            "center": {
              "$ref": "#/$defs/lane"
            },
            "trailing": {
              "$ref": "#/$defs/lane"
            }
          },
          "additionalProperties": false
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/camel"
          }
        },
        "textKeys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textKey"
          }
        },
        "where": {
          "$ref": "#/$defs/where"
        }
      },
      "additionalProperties": false
    }
  }
}
