{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "components.schema.json",
  "title": "ALFA components (library of parts, elements, states, mechanics)",
  "description": "components.json. One entry per data-part. Every measure, color and motion is a token alias, never a raw value. Elements carry the stable id that the drafts set as data-id and the code uses for the view.",
  "type": "object",
  "required": [
    "version",
    "components"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "alias": {
      "type": "string",
      "pattern": "^\\{[A-Za-z0-9]+(\\.[A-Za-z0-9]+)*\\}$"
    },
    "where": {
      "type": "string",
      "pattern": "^[^:]+\\.(dc\\.html|js|css):\\d+$"
    },
    "kebab": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "camel": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]*$"
    },
    "elementId": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-z0-9]*(-[a-z0-9]+)*)+$"
    },
    "textKey": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)+$"
    },
    "status": {
      "enum": [
        "approved",
        "approved-provisional",
        "set-by-design"
      ]
    },
    "tokenMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/camel"
      },
      "additionalProperties": {
        "$ref": "#/$defs/alias"
      }
    },
    "state": {
      "type": "object",
      "required": [
        "name",
        "tokens"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/camel"
        },
        "tokens": {
          "$ref": "#/$defs/tokenMap"
        },
        "where": {
          "$ref": "#/$defs/where"
        }
      },
      "additionalProperties": false
    },
    "mechanic": {
      "type": "object",
      "required": [
        "trigger",
        "from",
        "to",
        "transition",
        "reducedMotion"
      ],
      "properties": {
        "trigger": {
          "enum": [
            "hover",
            "press",
            "release",
            "hold",
            "click",
            "doubleClick",
            "drag",
            "scroll",
            "focus",
            "blur",
            "timer",
            "data",
            "appear",
            "disappear"
          ]
        },
        "from": {
          "$ref": "#/$defs/camel"
        },
        "to": {
          "$ref": "#/$defs/camel"
        },
        "transition": {
          "$ref": "#/$defs/alias"
        },
        "reducedMotion": {
          "enum": [
            "none",
            "crossfade",
            "instant"
          ]
        },
        "where": {
          "$ref": "#/$defs/where"
        }
      },
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "required": [
        "states",
        "events",
        "transitions"
      ],
      "properties": {
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/camel"
          },
          "minItems": 2
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/camel"
          },
          "minItems": 1
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "$ref": "#/$defs/camel"
              },
              {
                "$ref": "#/$defs/camel"
              },
              {
                "$ref": "#/$defs/camel"
              }
            ],
            "minItems": 3,
            "maxItems": 3
          }
        }
      },
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "required": [
        "id",
        "part",
        "where"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/elementId"
        },
        "formerId": {
          "$ref": "#/$defs/elementId"
        },
        "part": {
          "$ref": "#/$defs/kebab"
        },
        "action": {
          "$ref": "#/$defs/camel"
        },
        "textKey": {
          "$ref": "#/$defs/textKey"
        },
        "symbol": {
          "$ref": "#/$defs/camel"
        },
        "where": {
          "$ref": "#/$defs/where"
        }
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": [
        "part",
        "name",
        "category",
        "role",
        "layer",
        "measures",
        "states",
        "where",
        "status"
      ],
      "properties": {
        "part": {
          "$ref": "#/$defs/kebab"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "category": {
          "enum": [
            "primitive",
            "composite",
            "pattern"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "layer": {
          "$ref": "#/$defs/alias"
        },
        "anatomy": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "slot",
              "part"
            ],
            "properties": {
              "slot": {
                "$ref": "#/$defs/camel"
              },
              "part": {
                "$ref": "#/$defs/kebab"
              }
            },
            "additionalProperties": false
          }
        },
        "measures": {
          "$ref": "#/$defs/tokenMap"
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/state"
          }
        },
        "mechanics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mechanic"
          }
        },
        "flow": {
          "$ref": "#/$defs/flow"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "where": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/where"
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "category": {
            "const": "pattern"
          }
        }
      },
      "then": {
        "required": [
          "flow"
        ]
      }
    }
  }
}
