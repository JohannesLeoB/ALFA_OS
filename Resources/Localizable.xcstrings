    },
    "assistant.tool.propose_clickup_change.param.projekt" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projektnummer oder Titel, wenn kein Projekt offen ist"
          }
        },
        "en" : {
