    "assistant.tool.query_studio_knowledge.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsucht die lokale Studio-Wissensbasis aus der Projekthistorie (Projekte mit Phase/Problem-Signalen/Beträgen, Lieferanten, Team). Nutze sie für Fragen zu früheren oder laufenden Projekten, Kunden und Lieferanten. Leere/allgemeine Anfrage gibt eine Gesamtübersicht (Kennzahlen, Top-Köpfe/Lieferanten)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Searches the local studio knowledge base built from the project history (projects with phase/problem signals/amounts, suppliers, team). Use it for questions about past or ongoing projects, customers and suppliers. An empty/general query returns a full overview (figures, top people/suppliers)."
          }
        }
      }
    },
    "assistant.tool.query_studio_knowledge.param.query" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunde, Projekt, Ort oder Lieferant (leer = Übersicht)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Customer, project, place or supplier (empty = overview)"
          }
        }
      }
    },
    "assistant.tool.query_studio_knowledge.prompt" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- query_studio_knowledge: Studio-Wissensbasis aus der Projekthistorie (Projekte, Lieferanten, Team, Problem-Signale, Preis-Nennungen). Nutze sie für Fragen zu früheren/laufenden Projekten und Lieferanten. Sie ist ein Schnappschuss, nicht live: nenne bei jeder Aussage daraus das Stand-Datum aus der Werkzeug-Ausgabe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- query_studio_knowledge: studio knowledge base from the project history (projects, suppliers, team, problem signals, price mentions). Use it for questions about past/ongoing projects and suppliers. It is a snapshot, not live: with every statement from it, name the as-of date from the tool output."
          }
        }
      }
    },
    "assistant.tool.read_drive_file.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest den INHALT einer Datei im Google-Drive-Projektordner (PDF, Google Docs/Sheets/Slides, Textdateien) als Klartext. Nutze es, um z. B. einen Fragebogen, ein Angebot oder eine Notiz im Drive auszuwerten. 'datei' = Dateiname (Teil reicht). Im Projekt-Chat automatisch das offene Projekt; ein anderes Projekt über 'projekt' angeben. Nur lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads the CONTENT of a file in the Google Drive project folder (PDF, Google Docs/Sheets/Slides, text files) as plain text. Use it to evaluate e.g. a questionnaire, an offer or a note in Drive. 'datei' = file name (part is enough). In the project chat automatically the open project; give another project via 'projekt'. Read only."
          }
        }
      }
    },
    "assistant.tool.read_drive_file.param.datei" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateiname oder Teil davon (z. B. 'Fragebogen')"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File name or part of it (e.g. 'Fragebogen')"
          }
        }
      }
    },
    "assistant.tool.read_drive_file.param.projekt" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekt (Name/Nummer/Kunde) — leer = das offene Projekt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Project (name/number/customer) — empty = the open project"
          }
        }
      }
    },
    "assistant.tool.read_drive_file.prompt" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- read_drive_file: liest den INHALT einer Drive-Datei (PDF, Google Docs/Sheets/Slides, Text) als Klartext. Nutze es, um z. B. einen Fragebogen oder ein Angebot auszuwerten — du hast also sehr wohl Lesezugriff auf Dateiinhalte, behaupte nicht das Gegenteil. 'datei' = (Teil des) Dateinamens."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- read_drive_file: reads the CONTENT of a Drive file (PDF, Google Docs/Sheets/Slides, text) as plain text. Use it to evaluate e.g. a questionnaire or an offer — so you do have read access to file contents, do not claim the opposite. 'datei' = (part of the) file name."
          }
        }
      }
    },
    "assistant.tool.read_email.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest den VOLLEN Inhalt einer E-Mail (nicht nur die Vorschau). 'query' = Gmail-Suche, die die Mail eindeutig trifft (z. B. 'from:name subject:Leuchten'). Optional 'nummer' = n-ter Treffer (Standard 1). Nutze es, wenn der Nutzer den Mailinhalt wissen will."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads the FULL content of an email (not just the preview). 'query' = Gmail search that hits the mail unambiguously (e.g. 'from:name subject:Leuchten'). Optional 'nummer' = nth hit (default 1). Use it when the user wants to know the mail content."
          }
        }
      }
    },
    "assistant.tool.read_email.param.nummer" : {
      "localizations" : {
