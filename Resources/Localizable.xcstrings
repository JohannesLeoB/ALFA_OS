    "assistant.tool.lookup_kontakt.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsucht das Airtable-Kontaktverzeichnis (Kunden, Lieferanten, Handwerker, Team): liefert Name, Organisation, Telefon, E-Mail, ADRESSE, Kategorie, Projekt und Record-ID. Mit 'query' (Name, Organisation oder Projekt) suchen; ohne 'query' das Verzeichnis auflisten, optional mit 'kategorie' gefiltert. Nur lesen, kein Live-API-Call."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Searches the Airtable contact directory (customers, suppliers, tradespeople, team): returns name, organisation, phone, email, ADDRESS, category, project and record ID. Search with 'query' (name, organisation or project); without 'query' list the directory, optionally filtered with 'kategorie'. Read only, no live API call."
          }
        }
      }
    },
    "assistant.tool.lookup_kontakt.param.kategorie" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionaler Kategorie-Filter (z. B. Projektkunde, Lieferant, Handwerker, Team, Sonstige)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional category filter (e.g. Projektkunde, Lieferant, Handwerker, Team, Sonstige)"
          }
        }
      }
    },
    "assistant.tool.lookup_kontakt.param.query" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name, Organisation oder Projekt (leer = Verzeichnis auflisten)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name, organisation or project (empty = list directory)"
          }
        }
      }
    },
    "assistant.tool.lookup_kontakt.prompt" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- lookup_kontakt: Airtable-Kontaktverzeichnis (Kunden, Lieferanten, Handwerker, Team) mit Telefon, E-Mail und ADRESSE. Mit 'query' suchen, ohne 'query' (optional mit 'kategorie') auflisten. Nutze DIESES Werkzeug für Adress-/Telefon-/E-Mail-Fragen zu Personen (z. B. „Adresse Beispielkunde?“) — es ist lokal verfügbar, du musst dafür nicht auf Google warten. Du HAST also Zugriff auf die Kontakte — behaupte nie das Gegenteil."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- lookup_kontakt: Airtable contact directory (customers, suppliers, tradespeople, team) with phone, email and ADDRESS. Search with 'query', without 'query' (optionally with 'kategorie') list. Use THIS tool for address/phone/email questions about people (e.g. \"address of sample customer?\") — it is available locally, you do not have to wait for Google. So you HAVE access to the contacts — never claim the opposite."
          }
        }
      }
    },
    "assistant.tool.lookup_kunde.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsucht die lokal synchronisierten Kunden (nur lesen): Kundenname, Kundennummer und Anzahl Projekte. Liefert KEINE E-Mail/Telefon — dafür lookup_kontakt oder search_contacts. Leere Anfrage = Kundenübersicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Searches the locally synced customers (read only): customer name, customer number and number of projects. Returns NO email/phone — use lookup_kontakt or search_contacts for that. Empty query = customer overview."
          }
        }
      }
    },
    "assistant.tool.lookup_kunde.param.query" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kundenname oder Kundennummer (leer = Übersicht)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Customer name or customer number (empty = overview)"
          }
        }
      }
    },
    "assistant.tool.propose_clickup_change.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlägt eine Änderung in ClickUp vor: Aufgabe ANLEGEN, STATUS setzen (auch abhaken), FÄLLIGKEIT setzen oder ZUWEISEN. Du schreibst NICHT selbst — es entsteht eine Bestätigungskarte, erst der Klick des Nutzers führt aus. Im Projekt-Chat gilt die Liste des offenen Projekts; sonst 'projekt' (Nummer oder Titel) nennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggests a change in ClickUp: CREATE a task, set STATUS (also tick off), set DUE DATE or ASSIGN. You do NOT write yourself — a confirmation card is created, only the user's click executes. In the project chat the list of the open project applies; otherwise name 'projekt' (number or title)."
          }
        }
      }
    },
    "assistant.tool.propose_clickup_change.param.aktion" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anlegen | status | faelligkeit | zuweisen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "anlegen | status | faelligkeit | zuweisen"
          }
        }
      }
    },
    "assistant.tool.propose_clickup_change.param.aufgabe" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name der Aufgabe (bei anlegen der neue Name, sonst (Teil des) vorhandenen Namens)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name of the task (for anlegen the new name, otherwise (part of) the existing name)"
          }
        }
      }
    },
    "assistant.tool.propose_clickup_change.param.faellig" : {
