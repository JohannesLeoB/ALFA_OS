    "assistant.tool.propose_warenkorb.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlägt vor, einen Artikel in den Warenkorb zu legen. Du legst ihn NICHT selbst hinein — es entsteht eine Bestätigungskarte, erst der Klick des Nutzers legt ab. Der Artikel wird zuerst im Katalog, dann im Lager gesucht; ohne Treffer wird nichts vorgeschlagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggests putting an item into the cart. You do NOT put it in yourself — a confirmation card is created, only the user's click places it. The item is searched first in the catalog, then in stock; without a hit nothing is suggested."
          }
        }
      }
    },
    "assistant.tool.propose_warenkorb.param.artikel" : {
