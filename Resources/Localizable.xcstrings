            "state" : "translated",
            "value" : "Zielstatus, genau wie er in list_clickup_tasks in eckigen Klammern steht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Target status, exactly as it appears in square brackets in list_clickup_tasks"
          }
        }
      }
    },
    "assistant.tool.propose_clickup_change.param.wem" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei zuweisen: Name des Teammitglieds, wie es in ClickUp heißt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For zuweisen: name of the team member as it is called in ClickUp"
          }
        }
      }
    },
    "assistant.tool.propose_clickup_change.prompt" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- propose_clickup_change: schlägt vor, in ClickUp eine Aufgabe ANZULEGEN, ihren STATUS zu setzen (auch abhaken) oder die FÄLLIGKEIT zu setzen. Du schreibst NICHT selbst — es entsteht eine Bestätigungskarte, erst der Klick des Nutzers führt aus. Behaupte nie, es sei schon geschehen. Statusnamen nimmst du aus list_clickup_tasks."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- propose_clickup_change: suggests CREATING a task in ClickUp, setting its STATUS (also tick off) or setting the DUE DATE. You do NOT write yourself — a confirmation card is created, only the user's click executes. Never claim it has already happened. Take status names from list_clickup_tasks."
          }
        }
      }
    },
    "assistant.tool.propose_termin.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlägt einen Termin im Google-Kalender vor. Du legst ihn NICHT selbst an — es entsteht eine Bestätigungskarte, erst der Klick des Nutzers schreibt in den Kalender. Nimm dieses Werkzeug statt suggest_calendar_event, wenn der Termin wirklich eingetragen werden soll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suggests an appointment in Google Calendar. You do NOT create it yourself — a confirmation card is created, only the user's click writes to the calendar. Use this tool instead of suggest_calendar_event when the appointment is really to be entered."
          }
        }
      }
    },
