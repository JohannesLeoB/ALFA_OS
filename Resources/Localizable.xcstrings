    "assistant.calendar.ownOnly" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "WICHTIG: Es konnte NUR der eigene Kalender gelesen werden — die Team-Kalender nicht (die Kalenderlisten-Freigabe fehlt; in den Einstellungen erneut mit Google verbinden). Sage das dem Nutzer dazu. Behaupte NICHT, es gebe keine weiteren Termine."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IMPORTANT: ONLY the own calendar could be read — not the team calendars (the calendar list permission is missing; connect with Google again in Settings). Tell the user this as well. Do NOT claim there are no further appointments."
          }
        }
      }
    },
