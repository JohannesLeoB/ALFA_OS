    },
    "assistant.tool.schaetze_projekt.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstellt eine Kostenschätzung für ein Innenausbau-Projekt (Küche/Beleuchtung/Ausbau) auf Basis einer Freitext-Beschreibung. Gibt Min/Mitte/Max-Netto und Konfidenz zurück und legt dabei eine Lern-Sitzung in der Kalkulationsdatenbank an. Funktioniert auch ohne offenes Projekt (allgemeiner Assistent/Mail) — im Projekt-Chat wird die Schätzung zusätzlich diesem Projekt zugeordnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creates a cost estimate for an interior fit-out project (kitchen/lighting/fit-out) based on a free-text description. Returns min/mid/max net and confidence and creates a learning session in the calculation database. Also works without an open project (general assistant/mail) — in the project chat the estimate is additionally assigned to this project."
          }
        }
      }
    },
    "assistant.tool.schaetze_projekt.param.beschreibung" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freitext-Beschreibung (Raum, Materialien, Größe, Besonderheiten)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free-text description (room, materials, size, special features)"
          }
        }
      }
    },
    "assistant.tool.schaetze_projekt.param.entfernung_km" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernung zur Baustelle in Kilometern, für die Anfahrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance to the site in kilometres, for travel."
          }
        }
      }
    },
    "assistant.tool.schaetze_projekt.param.fronten" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausführung der Fronten: melamin, linoleum, furnier, lack, glas, massivholz oder edelstahl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Front finish: melamin, linoleum, furnier, lack, glas, massivholz or edelstahl."
          }
        }
      }
    },
    "assistant.tool.schaetze_projekt.param.korpusanzahl" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anzahl Korpusse, falls bekannt. Grober Anhalt: ein Laufmeter Küche ≈ 1,7 Korpusse. Stärkster Hebel auf die Spanne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Number of carcasses, if known. Rough guide: one running metre of kitchen ≈ 1.7 carcasses. Strongest lever on the range."
          }
        }
      }
    },
    "assistant.tool.schaetze_projekt.param.schubkaesten_holz" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anzahl Schubkästen in Massivholz."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Number of solid wood drawers."
          }
        }
      }
    },
    "assistant.tool.schaetze_projekt.param.schubkaesten_legrabox" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anzahl Schubkästen mit Serienauszug (Blum Legrabox o. ä.)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Number of drawers with series runners (Blum Legrabox or similar)."
          }
        }
      }
    },
    "assistant.tool.schaetze_projekt.param.werkstatt" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausführende Werkstatt, falls bekannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executing workshop, if known."
          }
        }
      }
    },
    "assistant.tool.schaetze_projekt.prompt" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- schaetze_projekt: Kostenschätzung (Min/Mitte/Max-Netto) aus der lokalen Kalkulationsdatenbank. Die Werkzeug-Karte IST die Schätzung: kommentiere ihre Zahlen (Annahmen, Unsicherheit, was fehlt), aber ersetze oder „korrigiere“ sie NIE durch eigene Hausnummern — eigene Beträge nennst du nur, wenn das Werkzeug fehlschlägt, und dann klar als grobe Einordnung markiert.\n  Das Band ist der Tischler-Einkaufspreis für Möbel: OHNE Marge, OHNE Geräte, OHNE Arbeitsplatte. Die Werkzeug-Ausgabe nennt diese Ausschlüsse als offene Zeilen — gib sie weiter, statt sie zu verschweigen. Setze NIE selbst eine Marge an und nenne nie eine Zahl „inklusive allem“, solange diese Zeilen offen sind.\n  Die Marge setzt ein Mensch, nie du. Sie ist bei jedem Projekt anders. Nenne nie einen Endkunden- oder Verkaufspreis und rechne keinen Aufschlag — alles, was du ausgibst, ist Einkauf.\n  Verfeinern statt neu raten: das Werkzeug nimmt korpusanzahl, fronten, schubkaesten_legrabox, schubkaesten_holz, werkstatt und entfernung_km entgegen. Nennt die Ausgabe Felder, die ohne Angabe geschätzt wurden, stelle dazu HÖCHSTENS zwei bis drei kurze Rückfragen und rufe das Werkzeug mit der Antwort erneut auf. Korpusanzahl, Werkstatt und Fronten bewegen die Spanne am stärksten; die Schubkastenzahl kaum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- schaetze_projekt: cost estimate (min/mid/max net) from the local calculation database. The tool card IS the estimate: comment on its numbers (assumptions, uncertainty, what is missing), but NEVER replace or \"correct\" them with your own ballpark figures — you name your own amounts only if the tool fails, and then clearly marked as a rough classification.\n  The band is the joiner's purchase price for furniture: WITHOUT margin, WITHOUT appliances, WITHOUT worktop. The tool output names these exclusions as open lines — pass them on instead of concealing them. NEVER set a margin yourself and never name a figure \"including everything\" while these lines are open.\n  The margin is set by a human, never by you. It differs for every project. Never name an end-customer or sales price and calculate no mark-up — everything you output is purchase cost.\n  Refine instead of guessing anew: the tool accepts korpusanzahl, fronten, schubkaesten_legrabox, schubkaesten_holz, werkstatt and entfernung_km. If the output names fields that were estimated without input, ask AT MOST two to three short follow-up questions and call the tool again with the answer. Carcass count, workshop and fronts move the range most; the drawer count hardly."
          }
        }
      }
    },
    "assistant.tool.schaetze_projekt.prompt.catalog" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  Geräte, Griffe und Ausstattung sind kein Schätzproblem: sie stehen im Katalog. Frag, ob sie mitgerechnet werden sollen, und schlage sie dann mit search_katalog nach. Nimm STRIKT den EK — das ganze Modell rechnet in Einkaufspreisen. Halte sie als eigene Positionen neben dem Möbelband, rechne sie nie hinein. Steht zu einem Artikel KEIN EK in der Tabelle, sage das und lass die Position offen: erfinde NIEMALS einen Preis, schätze ihn nicht, und leite ihn nicht aus einem VK ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "  Appliances, handles and fittings are not an estimation problem: they are in the catalog. Ask whether they should be included, then look them up with search_katalog. Take STRICTLY the cost price — the whole model calculates in purchase prices. Keep them as separate items next to the furniture band, never calculate them into it. If an item has NO cost price in the table, say so and leave the item open: NEVER invent a price, do not estimate it, and do not derive it from a sales price."
          }
        }
      }
    },
    "assistant.tool.search_contacts.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsucht die Google-Kontakte des verbundenen Accounts (nur lesen). Gibt Name, E-Mail, Telefon und Organisation passender Kontakte zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Searches the Google contacts of the connected account (read only). Returns name, email, phone and organisation of matching contacts."
          }
        }
      }
    },
    "assistant.tool.search_contacts.param.query" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suchbegriff (Name, Firma, E-Mail-Fragment)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Search term (name, company, email fragment)"
          }
        }
      }
    },
    "assistant.tool.search_contacts.prompt" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- search_contacts: Kontakte des verbundenen Accounts per Freitext suchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- search_contacts: search the contacts of the connected account by free text."
          }
        }
      }
    },
    "assistant.tool.search_gmail.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsucht die E-Mails des Nutzers (nur lesen). Verwende Gmail-Suchsyntax im query, z. B. 'from:name', 'to:name subject:Angebot', 'newer_than:30d', 'after:YYYY/MM/DD'. WICHTIG bei Alternativen: 'OR' IMMER großgeschrieben und bei gemischten Bedingungen klammern, z. B. 'from:(häfele OR haefele OR hafele) (Angebot OR Besteckeinsatz)' — NIEMALS unklammertes 'from:x OR y freitext OR z' (wird falsch geparst). Bei Namen mit Umlaut/Schreibvarianten zuerst eine EINFACHE Suche ohne OR probieren (z. B. nur 'from:häfele'), bevor komplexere OR-Ketten versucht werden. Gibt Treffer mit Betreff, Absender und Datum zurück. Für einen Rückblick über mehr Mails 'anzahl' erhöhen (Standard 25, max 100)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Searches the user's emails (read only). Use Gmail search syntax in query, e.g. 'from:name', 'to:name subject:Angebot', 'newer_than:30d', 'after:YYYY/MM/DD'. IMPORTANT for alternatives: ALWAYS capitalise 'OR' and use parentheses for mixed conditions, e.g. 'from:(häfele OR haefele OR hafele) (Angebot OR Besteckeinsatz)' — NEVER unbracketed 'from:x OR y freitext OR z' (is parsed wrongly). For names with umlauts/spelling variants first try a SIMPLE search without OR (e.g. only 'from:häfele') before trying more complex OR chains. Returns hits with subject, sender and date. For a look back over more mails raise 'anzahl' (default 25, max 100)."
          }
        }
      }
    },
    "assistant.tool.search_gmail.param.anzahl" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max. Trefferzahl (Standard 25, max 100)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Max. number of hits (default 25, max 100)"
          }
        }
      }
    },
    "assistant.tool.search_gmail.param.query" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gmail-Suchabfrage (Gmail-Operatoren erlaubt)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gmail search query (Gmail operators allowed)"
          }
        }
      }
    },
    "assistant.tool.search_gmail.prompt" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- search_gmail: Gmail durchsuchen (Betreff/Snippet). Mit 'anzahl' mehr Treffer für Rückblicke; Gmail-Operatoren wie 'after:YYYY/MM/DD' nutzbar. Die Suche umfasst das GANZE Postfach. 'OR' IMMER großgeschrieben + bei gemischten Bedingungen klammern (z. B. 'from:(häfele OR hafele) Angebot'); bei unsicherer Schreibweise erst EINFACH suchen, nicht sofort mehrteilige OR-Ketten bauen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- search_gmail: search Gmail (subject/snippet). With 'anzahl' more hits for look-backs; Gmail operators like 'after:YYYY/MM/DD' usable. The search covers the WHOLE mailbox. ALWAYS capitalise 'OR' + use parentheses for mixed conditions (e.g. 'from:(häfele OR hafele) Angebot'); when unsure of the spelling search SIMPLY first, do not build multi-part OR chains right away."
          }
        }
      }
    },
    "assistant.tool.search_katalog.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sucht Artikel und Geräte in der Artikeldatenbank (Gaggenau, Miele, Blum…). Gibt Hersteller, Bezeichnung, Artikelnummer, Verkaufspreis und Einkaufspreis zurück. Nützlich für Kalkulationsfragen wie \"Was kostet ein Gaggenau Backofen?\". Nur lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Searches items and appliances in the item database (Gaggenau, Miele, Blum…). Returns manufacturer, name, item number, sales price and purchase price. Useful for calculation questions like \"What does a Gaggenau oven cost?\". Read only."
          }
        }
      }
    },
