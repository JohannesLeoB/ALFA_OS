      }
    },
    "assistant.tool.create_note.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt eine persistente Notiz/Erinnerung an (lokal gespeichert, überlebt den Chat-/App-Neustart). Nutze es, wenn der Nutzer etwas notieren oder sich erinnern lassen will. Im Projekt-Chat wird die Notiz automatisch diesem Projekt zugeordnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creates a persistent note/reminder (stored locally, survives chat/app restart). Use it when the user wants to note something or be reminded. In the project chat the note is assigned to this project automatically."
          }
        }
      }
    },
    "assistant.tool.create_note.param.text" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
