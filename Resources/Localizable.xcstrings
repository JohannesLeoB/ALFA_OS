    "assistant.tool.erzeuge_datei.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzeugt eine Datei — Text, Tabelle (CSV) oder PDF — und legt sie im Datenordner der App ab. Mit 'projekt' erscheint zusätzlich eine Bestätigungskarte, erst der Klick des Nutzers legt sie auch in den Drive-Ordner dieses Projekts. Für CSV und für PDF-Tabellen: Spalten mit Semikolon trennen, eine Zeile je Datensatz, die erste Zeile ist die Kopfzeile."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creates a file — text, table (CSV) or PDF — and stores it in the app data folder. With 'projekt' a confirmation card also appears; only the user's click also puts it into this project's Drive folder. For CSV and PDF tables: separate columns with semicolons, one row per record, the first row is the header."
          }
        }
      }
    },
