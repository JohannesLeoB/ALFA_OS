    "assistant.tool.create_draft.prompt" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- create_draft: bereitet einen E-Mail-ENTWURF vor (Betreff/Text/optional Empfänger). Es entsteht eine Bestätigungskarte; der Nutzer legt den Entwurf in Gmail ab. Du VERSENDEST NIE und behauptest nie, die Mail sei gesendet/gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- create_draft: prepares an email DRAFT (subject/text/optional recipient). A confirmation card is created; the user saves the draft in Gmail. You NEVER SEND and never claim the mail was sent/saved."
          }
