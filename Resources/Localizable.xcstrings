    "assistant.tool.list_clickup_tasks.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listet offene ClickUp-Aufgaben (nur lesen) mit Status, Fälligkeit und Zuständigkeit. Ohne Parameter: die Liste des aktuellen Projekts (nur im Projekt-Chat). Mit 'alle=true' oder 'projekt' (Name/Nummer als Filter): projektübergreifende Übersicht aller offenen Aufgaben, gruppiert nach Projekt."
