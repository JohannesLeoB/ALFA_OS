    "assistant.tool.log_friction_point.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notiert einen kurzen Friktionspunkt im Assistenten-Tagebuch (append-only, kein Code-/Datei-Zugriff) — z. B. eine Datei, die du nicht lesen konntest, widersprüchliche Daten, oder eine fehlende Information. NICHT für normale Konversation nutzen, nur bei einem echten Hindernis bei der aktuellen Aufgabe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes a short friction point in the assistant journal (append-only, no code/file access) — e.g. a file you could not read, contradictory data, or missing information. Do NOT use for normal conversation, only for a real obstacle in the current task."
          }
        }
      }
    },
    "assistant.tool.log_friction_point.param.art" : {
      "localizations" : {
