    },
    "assistant.tool.read_email.param.query" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gmail-Suche, die die Mail trifft"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gmail search that hits the mail"
          }
