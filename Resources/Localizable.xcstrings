    "assistant.tool.find_offers.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Findet Angebote und Rechnungen im Google-Drive-Projektordner (eingehende UND ausgehende, auch verschachtelt z. B. in '01 INFOS'). Nur lesen. Im Projekt-Chat automatisch fürs offene Projekt; sonst das Projekt über 'projekt' (Name/Nummer/Kunde) angeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finds offers and invoices in the Google Drive project folder (incoming AND outgoing, also nested, e.g. in '01 INFOS'). Read only. In the project chat automatically for the open project; otherwise give the project via 'projekt' (name/number/customer)."
          }
        }
      }
    },
    "assistant.tool.find_offers.param.projekt" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekt (Name, Nummer oder Kunde) — nur nötig ohne offenes Projekt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Project (name, number or customer) — only needed without an open project"
          }
        }
      }
    },
    "assistant.tool.find_offers.prompt" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- find_offers: Angebote & Rechnungen im Drive finden (eingehend/ausgehend, auch verschachtelt in '01 INFOS'). Im Projekt-Chat automatisch das offene Projekt; ein anderes per 'projekt' nennen. Nutze DIESES Werkzeug für Angebots-/Rechnungsfragen statt zu sagen, Drive sei außer Reichweite."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- find_offers: find offers & invoices in Drive (incoming/outgoing, also nested in '01 INFOS'). In the project chat automatically the open project; name another one via 'projekt'. Use THIS tool for offer/invoice questions instead of saying Drive is out of reach."
          }
        }
      }
    },
    "assistant.tool.list_belege.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listet die in sevDesk angelegten Belege mit Belegnummer, Art, Projekt und Kunde. Nutze es bei Fragen nach Angeboten, Rechnungen oder Belegnummern. Nur lesen, legt nichts an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lists the receipts created in sevDesk with receipt number, kind, project and customer. Use it for questions about offers, invoices or receipt numbers. Read only, creates nothing."
          }
        }
      }
    },
