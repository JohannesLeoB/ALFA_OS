            "state" : "translated",
            "value" : "The note text"
          }
        }
      }
    },
    "assistant.tool.create_note.param.trotzdem" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "true = auch anlegen, wenn es schon eine sehr ähnliche Notiz gibt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "true = create even if a very similar note already exists"
          }
        }
      }
    },
    "assistant.tool.create_note.prompt" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- create_note: persistente Notizen & Erinnerungen lokal anlegen. Wenn der Nutzer etwas notieren oder sich erinnern lassen will, lege es mit create_note an (überlebt den Neustart) — KEIN Kalender-Link nötig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- create_note: create persistent notes & reminders locally. When the user wants to note something or be reminded, create it with create_note (survives restart) — NO calendar link needed."
          }
        }
      }
    },
    "assistant.tool.create_task.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt eine persistente Aufgabe/Erinnerung an (lokal, überlebt den Neustart). Nutze es für interne Memos und To-dos, die der Nutzer sich selbst setzt. Optionales Fälligkeitsdatum als ISO (yyyy-MM-dd); mit Fälligkeit wird eine Erinnerung ausgelöst. Im Projekt-Chat wird die Aufgabe automatisch diesem Projekt zugeordnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creates a persistent task/reminder (local, survives restart). Use it for internal memos and to-dos the user sets for themselves. Optional due date as ISO (yyyy-MM-dd); with a due date a reminder is triggered. In the project chat the task is assigned to this project automatically."
          }
        }
      }
    },
    "assistant.tool.create_task.param.faellig" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optionales Fälligkeitsdatum (yyyy-MM-dd), sonst leer"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optional due date (yyyy-MM-dd), otherwise empty"
          }
        }
      }
    },
    "assistant.tool.create_task.param.titel" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worum geht die Aufgabe"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What the task is about"
          }
        }
      }
    },
    "assistant.tool.create_task.prompt" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- create_task: interne Aufgabenliste (To-dos/Erinnerungen) lokal verwalten. Für kleine Memos und Erinnerungen, die der Nutzer sich selbst setzt; optionales Fälligkeitsdatum (yyyy-MM-dd), zu dem eine Erinnerung ausgelöst wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- create_task: manage the internal task list (to-dos/reminders) locally. For small memos and reminders the user sets for themselves; optional due date (yyyy-MM-dd) at which a reminder is triggered."
          }
        }
      }
