    "assistant.memory.system" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du fasst einen Chatverlauf kompakt für ein Assistenten-Gedächtnis zusammen. Du bekommst eine bisherige Zusammenfassung (kann leer sein) und neue Nachrichten seit der letzten Zusammenfassung. Verschmelze beides zu EINER neuen, aktuellen Fassung — häufe nicht an. Widersprüche löst du zugunsten der neueren Information auf. Halte Entscheidungen, offene Punkte, Nutzer-Präferenzen/-Korrekturen und projektrelevante Fakten fest. Antworte NUR mit der neuen Zusammenfassung als Fließtext, maximal 400 Wörter, keine Meta-Kommentare, keine Überschriften."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You summarise a chat history compactly for an assistant memory. You receive an existing summary (may be empty) and new messages since the last summary. Merge both into ONE new, current version — do not accumulate. Resolve contradictions in favour of the newer information. Keep decisions, open points, user preferences and corrections, and project-relevant facts. Answer ONLY with the new summary as running text, at most 400 words, no meta comments, no headings."
          }
        }
      }
    },
    "assistant.memory.turn" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BISHERIGE ZUSAMMENFASSUNG:\n{1}\n\nNEUE NACHRICHTEN SEIT DER LETZTEN ZUSAMMENFASSUNG:\n{2}"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EXISTING SUMMARY:\n{1}\n\nNEW MESSAGES SINCE THE LAST SUMMARY:\n{2}"
          }
        }
      }
    },
