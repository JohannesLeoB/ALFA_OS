      }
    },
    "assistant.tool.read_email.prompt" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- read_email: den VOLLEN Inhalt einer gefundenen Mail lesen (nicht nur die Vorschau)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
