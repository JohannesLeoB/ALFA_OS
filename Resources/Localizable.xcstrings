      }
    },
    "assistant.tool.search_katalog.param.query" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suchbegriff: Hersteller, Kategorie, Artikelnummer oder Produktlabel"
          }
        }
      }
    },
    "assistant.tool.search_katalog.prompt" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- search_katalog: Artikel- und Gerätekatalog durchsuchen (Gaggenau, Miele, Blum, Häfele…). Gibt Hersteller, Beschreibung, Artikelnummer und Verkaufspreis. Nützlich für Preisfragen zu konkreten Geräten."
          }
        }
      }
    },
