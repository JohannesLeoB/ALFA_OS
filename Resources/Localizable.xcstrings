    "assistant.tool.list_calendar_events.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listet anstehende Kalendertermine des Nutzers (nur lesen) — der eigene Kalender UND alle abonnierten Team-Kalender. Optionaler 'query'-Filter (Freitext über Titel/Ort), 'within_days' begrenzt den Zeitraum (Standard 14)."
