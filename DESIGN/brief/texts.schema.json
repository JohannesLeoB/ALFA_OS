{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "texts.schema.json",
  "title": "ALFA texts (visible strings, keyed, per language)",
  "description": "texts.json. Key in English, text per language. Source language de. Code generates Localizable.xcstrings from this file; a language switch needs no code change.",
  "type": "object",
  "required": [
    "version",
    "sourceLanguage",
    "texts"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sourceLanguage": {
      "const": "de"
    },
    "texts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/text"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "text": {
      "type": "object",
      "required": [
        "key",
        "de",
        "area",
        "kind"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)+$"
        },
        "formerKey": {
          "type": "string"
        },
        "de": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        },
        "area": {
          "enum": [
            "shell",
            "mail",
            "settings",
            "projects",
            "today",
            "catalogs",
            "cart"
          ]
        },
        "kind": {
          "enum": [
            "label",
            "button",
            "menu",
            "title",
            "state",
            "feedback",
            "confirm",
            "empty",
            "error",
            "placeholder",
            "tooltip"
          ]
        },
        "element": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-z0-9]*(-[a-z0-9]+)*)+$"
        },
        "placeholders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*$"
              },
              "type": {
                "enum": [
                  "string",
                  "integer",
                  "date"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "status": {
          "enum": [
            "approved",
            "approved-provisional",
            "set-by-design"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
